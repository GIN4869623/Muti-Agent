# Agent_SDR 后端地址（多后端逗号分隔，优先）
# 示例：usrp 跑在机器1，rag 跑在机器2
# AGENT_SDR_BASE_URLS=http://10.0.0.25:8000,http://10.0.0.26:8000
# 向下兼容（AGENT_SDR_BASE_URLS 未设置时生效）
# AGENT_SDR_BASE_URL=http://10.0.0.25:8000

# RIS 智能体后端地址（由 Next.js 服务端访问）
# RIS_AGENT_BASE_URL=http://10.0.0.30:8000

# Agent 事件上报共享密钥
# AGENT_EVENT_INGEST_TOKEN=replace-with-a-long-random-token

# App server
# PORT=3000
# HOST=127.0.0.1
